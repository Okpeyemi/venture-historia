# PostgreSQL — points to docker-compose service in dev
DATABASE_URL=postgres://venture:venture_dev_password@localhost:5433/venture_historia

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev-only: set to "true" to bypass Google OAuth and run as a synthetic
# user (useful when oauth2.googleapis.com is unreachable from your local
# network). Refused at boot when NODE_ENV=production. See README.
AUTH_DEV_BYPASS=false

# Anthropic — get a key from https://console.anthropic.com/settings/keys
# Required at boot. Plan #4 wires Claude into the game master, validator,
# and advisor agents.
ANTHROPIC_API_KEY=
